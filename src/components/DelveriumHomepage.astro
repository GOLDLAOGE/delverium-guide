---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import { site } from '~/config/site';
import { videoGameJsonLd, websiteJsonLd } from '~/lib/seo';

const guideAreas = [
  ['Getting Started', 'Your first hours in Delverium, with official context and clear gaps marked for follow-up.'],
  ['Co-op', 'What the official game information says about playing together on Steam.'],
  ['Crafting', 'A focused home for verified crafting notes as they become available.'],
  ['Farming & Building', 'A future reference for settling in, farming, and shaping your world.'],
  ['Dungeons', 'A careful guide area for dungeon exploration once details can be checked.'],
  ['Updates', 'Early Access changes, source links, and revisions collected in one place.'],
];

const officialScenes = [
  {
    label: 'Homestead',
    src: 'https://shared.cdn.queniuqe.com/store_item_assets/steam/apps/2710040/0d797766d99809a3f693dcde247836619ed5ce9a/ss_0d797766d99809a3f693dcde247836619ed5ce9a.1920x1080.jpg?t=1790022667',
  },
  {
    label: 'Exploration',
    src: 'https://shared.cdn.queniuqe.com/store_item_assets/steam/apps/2710040/685d154fe6e466b37bcc1a0f89649659c2b0c34e/ss_685d154fe6e466b37bcc1a0f89649659c2b0c34e.1920x1080.jpg?t=1790022667',
  },
  {
    label: 'Dungeons',
    src: 'https://shared.cdn.queniuqe.com/store_item_assets/steam/apps/2710040/433db92ccf897b847cb7438711142c0cd1979f7f/ss_433db92ccf897b847cb7438711142c0cd1979f7f.1920x1080.jpg?t=1790022667',
  },
];

const firstSteps = [
  ['Try the demo', 'Steam lists a free Delverium demo, so it is the safest place to get a feel for the game before relying on player advice.'],
  ['Choose your pace', 'The official listing supports solo play, shared or split-screen co-op, and online co-op — start with the mode that suits your group.'],
  ['Track official changes', 'Early Access changes quickly. Check the Steam news hub before treating any guide detail as current.'],
];

const faqs = [
  ['When did Delverium enter Early Access?', 'Steam lists Sep 21, 2026 as both the release date and Early Access release date.'],
  ['How many players does Delverium support?', 'The official listing describes a one-to-eight player survival sandbox adventure.'],
  ['Where can I play Delverium?', 'Delverium is listed for PC on Steam.'],
  ['Does Delverium support co-op?', 'Yes. Steam lists online co-op and shared or split-screen co-op support.'],
  ['Is Delverium Guide official?', 'No. This is an unofficial fan guide; Steam and Sagestone Games sources take priority when facts change.'],
];

const jsonLd = [websiteJsonLd('en'), videoGameJsonLd()];
---

<BaseLayout
  title="Delverium Guide"
  description={site.description}
  locale="en"
  alternates={[{ hreflang: 'en', href: 'https://delveriumguide.com/' }]}
  jsonLd={jsonLd}
>
  <div class="site-shell">
    <header class="site-header" aria-label="Delverium Guide navigation">
      <a class="wordmark" href="#top" aria-label="Delverium Guide home">DELVERIUM <span>GUIDE</span></a>
      <nav aria-label="Primary navigation">
        <a href="#guides">Guides</a>
        <a href="#about">About</a>
        <a href="#sources">Sources</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="page-title">
        <div class="hero-copy-block">
          <p class="eyebrow">Independent guidebook · Early Access</p>
          <h1 id="page-title">Delverium Guide</h1>
          <p class="hero-copy">A careful, source-led companion for exploring Delverium — built to separate confirmed information from what still needs to be learned.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#guides">Explore the guide map</a>
            <a class="button button-secondary" href="https://store.steampowered.com/app/2710040/Delverium/" rel="noopener noreferrer">View on Steam <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <a class="hero-media" href="https://store.steampowered.com/app/2710040/Delverium/" rel="noopener noreferrer">
          <img src={officialScenes[2].src} alt="Official Steam screenshot: Dungeons" />
          <span>Official Steam screenshot <b aria-hidden="true">↗</b></span>
        </a>
      </section>

      <section class="guide-map" id="guides" aria-labelledby="guides-title">
        <div class="section-heading">
          <p class="eyebrow">Start here</p>
          <h2 id="guides-title">Guide map</h2>
          <p>Six practical paths, opening as their information is verified.</p>
        </div>
        <div class="guide-grid">
          {guideAreas.map(([title, description], index) => (
            <article class="guide-card" aria-label={`${title}: guide in preparation`} aria-disabled="true">
              <span class="card-number">0{index + 1}</span>
              <h3>{title}</h3>
              <p>{description}</p>
              <span class="card-status">Guide in preparation</span>
            </article>
          ))}
        </div>
      </section>

      <section class="trust-strip" aria-label="Confirmed Delverium facts">
        <p><strong>PC on Steam</strong><span>Platform</span></p>
        <p><strong>1–8 players</strong><span>Official listing</span></p>
        <p><strong>Early Access</strong><span>Development status</span></p>
      </section>

      <section class="overview" aria-labelledby="overview-title">
        <div>
          <p class="eyebrow">Game overview</p>
          <h2 id="overview-title">About Delverium</h2>
        </div>
        <div class="overview-copy">
          <p>Delverium is a 2D pixel survival sandbox adventure from Sagestone Games. Its official Steam listing describes a procedurally generated world where one to eight players can explore, gather resources, build shelters, tend farms, craft items, recruit NPCs, and venture into caves and dungeons.</p>
          <a href="https://store.steampowered.com/app/2710040/Delverium/" rel="noopener noreferrer">Read the official Steam overview <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="scene-gallery" aria-labelledby="scenes-title">
        <div class="section-heading">
          <p class="eyebrow">From the official listing</p>
          <h2 id="scenes-title">See the world before you enter it.</h2>
          <p>Official Steam screenshots, selected as visual signposts for the guides to come.</p>
        </div>
        <div class="scene-grid">
          {officialScenes.map((scene) => (
            <a href="https://store.steampowered.com/app/2710040/Delverium/" rel="noopener noreferrer">
              <figure>
                <img src={scene.src} alt={`Official Steam screenshot: ${scene.label}`} loading="lazy" />
                <figcaption>{scene.label}<span>Official Steam screenshot</span></figcaption>
              </figure>
            </a>
          ))}
        </div>
      </section>

      <section class="editorial" id="about" aria-labelledby="about-title">
        <div>
          <p class="eyebrow">The editorial promise</p>
          <h2 id="about-title">Useful without pretending to know more than we do.</h2>
        </div>
        <p>Delverium is changing in Early Access. This guide will publish only confirmed gameplay information, link it to official sources where possible, and label unverified player observations plainly.</p>
      </section>

      <section class="first-steps" aria-labelledby="first-steps-title">
        <div class="section-heading">
          <p class="eyebrow">A clear first visit</p>
          <h2 id="first-steps-title">Start here</h2>
          <p>Use official information as the baseline, then let detailed guides earn their place.</p>
        </div>
        <ol>
          {firstSteps.map(([title, description], index) => (
            <li>
              <span>0{index + 1}</span>
              <div><h3>{title}</h3><p>{description}</p></div>
            </li>
          ))}
        </ol>
        <a class="update-link" href="https://store.steampowered.com/news/app/2710040" rel="noopener noreferrer">Official update history <span aria-hidden="true">↗</span></a>
      </section>

      <section class="faq" aria-labelledby="faq-title">
        <p class="eyebrow">Quick facts</p>
        <h2 id="faq-title">Frequently asked questions</h2>
        <div class="faq-grid">
          {faqs.map(([question, answer]) => (
            <article><h3>{question}</h3><p>{answer}</p></article>
          ))}
        </div>
      </section>

      <section class="sources" id="sources" aria-labelledby="sources-title">
        <p class="eyebrow">Source policy</p>
        <h2 id="sources-title">Built from official sources, then checked again.</h2>
        <p><a href="https://store.steampowered.com/app/2710040/Delverium/" rel="noopener noreferrer">Steam's official Delverium listing</a> and Sagestone Games materials are the starting point. Community findings may be included only with a visible verification note, so readers can tell fact from an open question.</p>
      </section>
    </main>

    <footer class="site-footer">
      <p>© 2026 Delverium Guide</p>
      <p>Delverium Guide is an unofficial fan guide. Not affiliated with or endorsed by Sagestone Games.</p>
    </footer>
  </div>
</BaseLayout>

<style>
  :global(body.min-h-screen) { background: #151714 !important; color: #f1ead9 !important; }
  .site-shell { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
  .site-header { align-items: center; border-bottom: 1px solid rgba(234, 223, 193, .16); display: flex; justify-content: space-between; min-height: 82px; }
  .wordmark { color: #f1ead9; font-family: Georgia, serif; font-size: .9rem; font-weight: 700; letter-spacing: .18em; text-decoration: none; }
  .wordmark span { color: #ba744b; }
  nav { display: flex; gap: 24px; }
  nav a { color: #c9c4b2; font-size: .83rem; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
  nav a:hover, nav a:focus-visible { color: #e3a170; }
  .hero { align-items: center; border-bottom: 1px solid rgba(234, 223, 193, .16); display: grid; gap: clamp(38px, 7vw, 116px); grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); padding: 112px 0; position: relative; }
  .hero::after { background: radial-gradient(circle, rgba(129, 153, 94, .2), transparent 64%); content: ''; height: 440px; pointer-events: none; position: absolute; right: -130px; top: 15px; width: 440px; }
  .hero-copy-block, .hero-media { position: relative; z-index: 1; }
  .eyebrow { color: #ba744b; font-size: .75rem; font-weight: 700; letter-spacing: .16em; margin: 0 0 18px; text-transform: uppercase; }
  h1, h2, h3 { font-family: Georgia, 'Times New Roman', serif; }
  h1 { font-size: clamp(3.5rem, 9vw, 7.5rem); letter-spacing: -.06em; line-height: .9; margin: 0; max-width: 780px; position: relative; z-index: 1; }
  .hero-copy { color: #c9c4b2; font-size: 1.15rem; line-height: 1.7; margin: 32px 0; max-width: 620px; position: relative; z-index: 1; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; position: relative; z-index: 1; }
  .hero-media { background: #1d201b; border: 1px solid rgba(234, 223, 193, .18); color: #f1ead9; display: block; overflow: hidden; text-decoration: none; }
  .hero-media img { aspect-ratio: 4 / 3; display: block; filter: saturate(.9); object-fit: cover; transition: filter .2s ease, transform .2s ease; width: 100%; }
  .hero-media:hover img, .hero-media:focus-visible img { filter: saturate(1.08); transform: scale(1.02); }
  .hero-media span { display: block; font-size: .68rem; font-weight: 700; letter-spacing: .09em; padding: 13px 16px; text-transform: uppercase; }
  .button { border: 1px solid; font-size: .82rem; font-weight: 700; letter-spacing: .08em; padding: 14px 19px; text-decoration: none; text-transform: uppercase; }
  .button-primary { background: #ba744b; border-color: #ba744b; color: #171512; }
  .button-primary:hover, .button-primary:focus-visible { background: #e3a170; border-color: #e3a170; }
  .button-secondary { border-color: rgba(234, 223, 193, .4); color: #f1ead9; }
  .button-secondary:hover, .button-secondary:focus-visible { border-color: #e3a170; color: #e3a170; }
  .guide-map { padding: 108px 0; }
  .section-heading { align-items: end; display: flex; gap: 30px; justify-content: space-between; margin-bottom: 38px; }
  .section-heading .eyebrow { left: 0; position: absolute; transform: translateY(-44px); }
  h2 { font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -.04em; line-height: 1; margin: 0; }
  .section-heading > p:last-child { color: #9da093; line-height: 1.55; margin: 0; max-width: 280px; }
  .guide-grid { display: grid; gap: 1px; grid-template-columns: repeat(3, 1fr); background: rgba(234, 223, 193, .16); border: 1px solid rgba(234, 223, 193, .16); }
  .guide-card { background: #1d201b; min-height: 232px; padding: 28px; }
  .card-number { color: #81995e; font-size: .78rem; font-weight: 700; letter-spacing: .08em; }
  .guide-card h3 { font-size: 1.55rem; margin: 38px 0 10px; }
  .guide-card p { color: #aaa999; font-size: .92rem; line-height: 1.55; margin: 0; }
  .card-status { color: #ba744b; display: block; font-size: .7rem; font-weight: 700; letter-spacing: .09em; margin-top: 22px; text-transform: uppercase; }
  .trust-strip { border-bottom: 1px solid rgba(234, 223, 193, .16); border-top: 1px solid rgba(234, 223, 193, .16); display: grid; grid-template-columns: repeat(3, 1fr); margin: 0 -32px; padding: 32px; }
  .trust-strip p { border-left: 2px solid #81995e; margin: 0; padding-left: 14px; }
  .trust-strip strong, .trust-strip span { display: block; }
  .trust-strip strong { font-family: Georgia, serif; font-size: 1.25rem; }
  .trust-strip span { color: #9da093; font-size: .75rem; margin-top: 5px; text-transform: uppercase; }
  .overview { display: grid; gap: 64px; grid-template-columns: 1fr 1fr; padding: 108px 0 0; }
  .overview-copy p { color: #c9c4b2; font-size: 1.08rem; line-height: 1.75; margin: 0; }
  .overview-copy a, .update-link { color: #e3a170; display: inline-block; font-size: .78rem; font-weight: 700; letter-spacing: .08em; margin-top: 22px; text-decoration: none; text-transform: uppercase; }
  .overview-copy a:hover, .overview-copy a:focus-visible, .update-link:hover, .update-link:focus-visible { color: #f1ead9; }
  .scene-gallery { padding: 108px 0 0; }
  .scene-grid { display: grid; gap: 16px; grid-template-columns: repeat(3, 1fr); }
  .scene-grid a { color: inherit; text-decoration: none; }
  .scene-grid figure { background: #1d201b; margin: 0; overflow: hidden; }
  .scene-grid img { aspect-ratio: 4 / 3; display: block; filter: saturate(.88); object-fit: cover; transition: filter .2s ease, transform .2s ease; width: 100%; }
  .scene-grid a:hover img, .scene-grid a:focus-visible img { filter: saturate(1.08); transform: scale(1.025); }
  .scene-grid figcaption { font-family: Georgia, serif; font-size: 1.25rem; padding: 16px 18px 18px; }
  .scene-grid figcaption span { color: #9da093; display: block; font-family: system-ui, sans-serif; font-size: .68rem; letter-spacing: .08em; margin-top: 5px; text-transform: uppercase; }
  .editorial { display: grid; gap: 64px; grid-template-columns: 1fr 1fr; padding: 108px 0; }
  .editorial > p, .sources > p:last-child { color: #c9c4b2; font-size: 1.08rem; line-height: 1.75; margin: 0; }
  .first-steps { padding: 108px 0; }
  .first-steps ol { border-top: 1px solid rgba(234, 223, 193, .16); list-style: none; margin: 38px 0 0; padding: 0; }
  .first-steps li { align-items: start; border-bottom: 1px solid rgba(234, 223, 193, .16); display: grid; gap: 28px; grid-template-columns: 52px 1fr; padding: 28px 0; }
  .first-steps li > span { color: #81995e; font-size: .78rem; font-weight: 700; letter-spacing: .08em; padding-top: 5px; }
  .first-steps h3, .faq h3 { font-size: 1.35rem; margin: 0 0 8px; }
  .first-steps li p, .faq p { color: #aaa999; line-height: 1.6; margin: 0; max-width: 650px; }
  .faq { border-top: 1px solid rgba(234, 223, 193, .16); padding: 108px 0; }
  .faq > h2 { margin-bottom: 38px; }
  .faq-grid { display: grid; gap: 1px; grid-template-columns: repeat(2, 1fr); background: rgba(234, 223, 193, .16); border: 1px solid rgba(234, 223, 193, .16); }
  .faq-grid article { background: #1d201b; padding: 28px; }
  .sources { background: #d9d1bc; color: #25241e; margin: 0 -32px; padding: 78px 32px; }
  .sources .eyebrow { color: #765032; }
  .sources h2 { max-width: 650px; }
  .sources > p:last-child { color: #57584e; margin-top: 22px; max-width: 720px; }
  .sources a { color: #5d3e29; text-decoration-color: #ba744b; text-underline-offset: 3px; }
  .sources a:hover, .sources a:focus-visible { color: #1f3020; }
  .site-footer { color: #8f9184; display: flex; font-size: .78rem; gap: 24px; justify-content: space-between; line-height: 1.55; padding: 30px 0; }
  .site-footer p { margin: 0; }
  .site-footer p:last-child { max-width: 460px; text-align: right; }
  a:focus-visible { outline: 2px solid #e3a170; outline-offset: 4px; }
  @media (max-width: 767px) {
    .site-shell { padding: 0 20px; }
    .site-header { min-height: 70px; }
    nav { gap: 14px; }
    nav a { font-size: .67rem; }
    .hero { display: block; padding: 94px 0 78px; }
    .hero::after { right: -240px; top: -90px; }
    .hero-media { margin-top: 38px; }
    .section-heading, .editorial { display: block; }
    .section-heading > p:last-child { margin-top: 18px; }
    .guide-map, .overview, .scene-gallery, .editorial, .first-steps, .faq { padding: 76px 0; }
    .guide-grid { grid-template-columns: 1fr; }
    .guide-card { min-height: auto; }
    .trust-strip { grid-template-columns: 1fr; margin: 0 -20px; padding: 24px 20px; row-gap: 22px; }
    .sources { margin: 0 -20px; padding: 58px 20px; }
    .scene-grid { grid-template-columns: 1fr; }
    .overview { display: block; }
    .overview-copy { margin-top: 24px; }
    .faq-grid { grid-template-columns: 1fr; }
    .site-footer { display: block; }
    .site-footer p + p { margin-top: 12px; }
    .site-footer p:last-child { text-align: left; }
  }
</style>
