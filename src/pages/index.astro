---
/**
 * Root index — handles the default-locale (English) homepage.
 *
 * With `prefixDefaultLocale: false`, the root URL `/` maps here directly
 * (not to /en/). We render the English homepage inline rather than redirecting,
 * because a redirect adds a round-trip and hurts LCP.
 *
 * Non-default locales use /ja/ etc., handled by src/pages/[locale]/index.astro.
 */
import DelveriumHomepage from '~/components/DelveriumHomepage.astro';
---

<DelveriumHomepage />
